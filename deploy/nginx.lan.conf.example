# Template HTTP-only ingress for office LAN deployment.
# Copy this file to deploy/nginx.lan.conf and adjust allow rules for your internal LAN subnets.
server {
    listen 80;
    server_name _;
    # Replace with your office LAN subnet(s)
    allow 192.168.1.0/24;
    allow 127.0.0.1;
    deny all;

    client_max_body_size 50M;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        allow all;
        access_log off;
        return 200 "OK\n";
    }

    location /api/v1/ {
        proxy_pass http://backend:5000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Discard client-supplied forwarding headers at this ingress.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /readyz {
        proxy_pass http://backend:5000/health/ready;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
