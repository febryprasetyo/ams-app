[Unit]
Description=AMS Production PostgreSQL Daily Backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/opt/ams-app/deploy/scripts/backup-postgres.sh /var/backups/ams-app/postgres ams_prod_db
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
